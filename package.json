{
  "name": "finance-app",
  "version": "1.0.0",
  "private": true,
  "description": "Finance Management System (LoanFlowPro / Finova)",
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "dev:backend": "npm --prefix backend run dev",
    "start": "npm --prefix frontend run dev",
    "build": "npm --prefix frontend run build",
    "install:all": "npm --prefix backend install --omit=optional && npm --prefix frontend install"
  }
}
