# Finova Backend Environment Configuration

# Server Port
PORT=5000
NODE_ENV=development

# Database Connection (PostgreSQL)
# Example local: postgresql://postgres:postgres@localhost:5432/finance_db?schema=public
# Example cloud (Render/Neon/Supabase): postgresql://user:password@ep-xyz.region.neon.tech/dbname?sslmode=require
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/finance_db?schema=public"

# JWT Authentication Secrets
JWT_SECRET="finova-jwt-super-secret-key-2026"
JWT_EXPIRES_IN="365d"
JWT_REFRESH_SECRET="finova-jwt-refresh-super-secret-key-2026"
JWT_REFRESH_EXPIRES_IN="365d"

# Default Seed Super Admin Credentials
ADMIN_EMAIL="admin@loanflow.com"
ADMIN_PASSWORD="Admin@123456"
ADMIN_NAME="Super Admin"
ADMIN_PHONE="9999999999"
COMPANY_ID="company-finova-001"

# Security & CORS
FRONTEND_URL="*"
DISABLE_RATE_LIMIT="true"
DISABLE_WHATSAPP="true"
